{
  "compilerOptions": {
    // Enable latest features
    "lib": ["ESNext", "DOM", "DOM.Iterable", "DOM.AsyncIterable"],
    "target": "ESNext",
    "module": "ESNext",
    "moduleDetection": "force",
    "jsx": "react",
    "jsxFactory": "React.createElement",
    "jsxFragmentFactory": "React.Fragment",
    "allowJs": false,

    // Bundler mode
    "moduleResolution": "bundler",
    "allowImportingTsExtensions": true,
    "verbatimModuleSyntax": true,
    "noEmit": true,

    // Best practices
    "strict": true,
    "skipLibCheck": true,
    "noFallthroughCasesInSwitch": true,
    "noImplicitAny": true,

    // Some stricter flags
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noPropertyAccessFromIndexSignature": false,

    // Import aliases
    "paths": {
        "@assets/*": ["./assets/*"],
        "@common/*": ["./src/common/*"],
        "@builtins/*": ["./src/ghostclient/builtins/*"],
        "@data/*": ["./src/ghostclient/data/*"],
        "@api/*": ["./src/ghostclient/api/*"],
        "@modules/*": ["./src/ghostclient/modules/*"],
        "@polyfill/*": ["./src/ghostclient/polyfill/*"],
        "@stores/*": ["./src/ghostclient/stores/*"],
        "@structs/*": ["./src/ghostclient/structs/*"],
        "@styles/*": ["./src/ghostclient/styles/*"],
        "@ui/*": ["./src/ghostclient/ui/*"],
        "@utils/*": ["./src/ghostclient/utils/*"],
        "@webpack": ["./src/ghostclient/webpack"],
        "@bundled/*": ["./src/ghostclient/bundled/*"],
    },
    "typeRoots": ["node_modules/@types", "src/ghostclient/types"]
  },
  "include": [
    "src/**/*",
    "scripts/*",
    "tests/**/*"
  ],
}